# ---------------------------------------------------------------------------
# CarBuddy API — copy to `.env` for local development.
# Never commit real values. Production secrets belong in your secret manager.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://carbuddy:carbuddy@localhost:5432/carbuddy?schema=public"

# JWT signing. Generate with: openssl rand -base64 48
# Access and refresh use SEPARATE secrets so a leaked access-token secret
# cannot be used to mint refresh tokens.
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="60d"

# Object storage for receipts and document scans (S3-compatible)
STORAGE_BUCKET="carbuddy-attachments"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Encryption key for sensitive columns (VIN, document numbers).
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=""

# Push notifications
EXPO_ACCESS_TOKEN=""

# CORS — comma separated. Leave empty to allow only the mobile app.
CORS_ORIGINS=""

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
