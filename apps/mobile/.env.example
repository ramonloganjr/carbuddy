# Copy to `.env` for local development. Never commit real values.
#
# Only non-secret configuration belongs here: everything in `extra` is readable
# from the shipped bundle. API secrets live on the server; signing credentials
# live in EAS.

APP_ENV=development
API_URL=http://localhost:4000
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
